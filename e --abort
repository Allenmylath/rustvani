[32m+[m
[32m+[m[32mtype WsStream = futures::stream::SplitStream<[m
[32m+[m[32m    tokio_tungstenite::WebSocketStream<[m
[32m+[m[32m        tokio_tungstenite::MaybeTlsStream<tokio::net::TcpStream>,[m
[32m+[m[32m    >,[m
[32m+[m[32m>;[m
[32m+[m
[32m+[m[32masync fn run_send_task(mut sink: WsSink, mut rx: mpsc::Receiver<Message>) {[m
[32m+[m[32m    while let Some(msg) = rx.recv().await {[m
[32m+[m[32m        if sink.send(msg).await.is_err() {[m
[32m+[m[32m            log::warn!("GnaniStt: send failed — closing send task");[m
[32m+[m[32m            break;[m
[32m+[m[32m        }[m
[32m+[m[32m    }[m
[32m+[m[32m    let _ = sink.close().await;[m
[32m+[m[32m    log::debug!("GnaniStt: send task exited");[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32masync fn run_receive_task([m
[32m+[m[32m    mut stream:          WsStream,[m
[32m+[m[32m    processor:           FrameProcessor,[m
[32m+[m[32m    language_fallback:   String,[m
[32m+[m[32m) {[m
