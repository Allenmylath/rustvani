[32m+[m
[32m+[m[32m    while let Some(result) = stream.next().await {[m
[32m+[m[32m        match result {[m
[32m+[m[32m            Ok(Message::Text(text)) => {[m
[32m+[m[32m                handle_message(text.as_str(), &processor, &language_fallback).await;[m
[32m+[m[32m            }[m
[32m+[m[32m            Ok(Message::Close(_)) => {[m
[32m+[m[32m                log::info!("GnaniStt: server closed WebSocket");[m
[32m+[m[32m                break;[m
[32m+[m[32m            }[m
[32m+[m[32m            Err(e) => {[m
[32m+[m[32m                let _ = processor[m
[32m+[m[32m                    .push_error(format!("GnaniStt: receive error: {}", e), false)[m
[32m+[m[32m                    .await;[m
