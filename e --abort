[32m+[m
[32m+[m[32mimpl GnaniSttHandler {[m
[32m+[m[32m    async fn connect(&self, processor: FrameProcessor) {[m
[32m+[m[32m        let url = self.config.ws_url();[m
[32m+[m[32m        log::info!("GnaniStt: connecting to {}", url);[m
[32m+[m
[32m+[m[32m        let mut request_builder = Request::builder()[m
[32m+[m[32m            .uri(&url)[m
[32m+[m[32m            .header("Host", "api.vachana.ai")[m
[32m+[m[32m            .header("x-api-key-id", &self.config.api_key)[m
[32m+[m[32m            .header("lang_code", &self.config.language_code)[m
[32m+[m[32m            .header("x-sample-rate", self.config.sample_rate.to_string())[m
[32m+[m[32m            .header("x-format", &self.config.format)[m
[32m+[m[32m            .header("Connection", "Upgrade")[m
[32m+[m[32m            .header("Upgrade", "websocket")[m
[32m+[m[32m            .header("Sec-WebSocket-Version", "13")[m
[32m+[m[32m            .header([m
[32m+[m[32m                "Sec-WebSocket-Key",[m
[32m+[m[32m                tokio_tungstenite::tungstenite::handshake::client::generate_key(),[m
[32m+[m[32m            );[m
[32m+[m
[32m+[m[32m        if self.config.itn_native_numerals {[m
[32m+[m[32m            request_builder = request_builder.header("itn_native_numerals", "true");[m
[32m+[m[32m        }[m
[32m+[m
[32m+[m[32m        let request = match request_builder.body(()) {[m
[32m+[m[32m            Ok(r) => r,[m
[32m+[m[32m            Err(e) => {[m
[32m+[m[32m                let _ = processor[m
[32m+[m[32m                    .push_error(format!("GnaniStt: request build failed: {}", e), false)[m
[32m+[m[32m                    .await;[m
[32m+[m[32m                return;[m
[32m+[m[32m            }[m
[32m+[m[32m        };[m
[32m+[m
[32m+[m[32m        let ws_stream = match tokio_tungstenite::connect_async(request).await {[m
[32m+[m[32m            Ok((stream, _)) => stream,[m
[32m+[m[32m            Err(e) => {[m
[32m+[m[32m                let _ = processor[m
[32m+[m[32m                    .push_error(format!("GnaniStt: connect failed: {}", e), false)[m
[32m+[m[32m                    .await;[m
[32m+[m[32m                return;[m
[32m+[m[32m            }[m
[32m+[m[32m        };[m
[32m+[m
[32m+[m[32m        let (sink, stream) = ws_stream.split();[m
[32m+[m[32m        let (ws_tx, ws_rx) = mpsc::channel::<Message>(64);[m
[32m+[m
[32m+[m[32m        let send_task    = tokio::spawn(run_send_task(sink, ws_rx));[m
[32m+[m[32m        let lang_clone   = self.config.language_code.clone();[m
[32m+[m[32m        let receive_task = tokio::spawn(run_receive_task(stream, processor, lang_clone));[m
[32m+[m
[32m+[m[32m        let mut state = self.state.lock().await;[m
[32m+[m[32m        state.ws_tx        = Some(ws_tx);[m
[32m+[m[32m        state.send_task    = Some(send_task);[m
[32m+[m[32m        state.receive_task = Some(receive_task);[m
[32m+[m
[32m+[m[32m        log::info!("GnaniStt: connected");[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    async fn disconnect(&self) {[m
[32m+[m[32m        let mut state = self.state.lock().await;[m
[32m+[m[32m        if let Some(h) = state.receive_task.take() { h.abort(); }[m
[32m+[m[32m        if let Some(h) = state.send_task.take()    { h.abort(); }[m
[32m+[m[32m        state.ws_tx = None;[m
[32m+[m[32m        state.audio_buffer.clear();[m
[32m+[m[32m        log::info!("GnaniStt: disconnected");[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    /// Buffer audio into 1024-byte chunks and send as binary WS messages.[m
[32m+[m[32m    async fn send_audio(&self, audio: &[u8]) {[m
[32m+[m[32m        let mut state = self.state.lock().await;[m
[32m+[m[32m        state.audio_buffer.extend_from_slice(audio);[m
[32m+[m
[32m+[m[32m        while state.audio_buffer.len() >= CHUNK_SIZE {[m
[32m+[m[32m            let chunk: Vec<u8> = state.audio_buffer.drain(..CHUNK_SIZE).collect();[m
[32m+[m[32m            if let Some(tx) = &state.ws_tx {[m
[32m+[m[32m                let _ = tx.send(Message::Binary(chunk.into())).await;[m
[32m+[m[32m            }[m
[32m+[m[32m        }[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    /// Send any remaining buffered audio (partial frame allowed on flush).[m
[32m+[m[32m    async fn flush_audio(&self) {[m
[32m+[m[32m        let mut state = self.state.lock().await;[m
[32m+[m[32m        if !state.audio_buffer.is_empty() {[m
[32m+[m[32m            let chunk: Vec<u8> = state.audio_buffer.drain(..).collect();[m
[32m+[m[32m            if let Some(tx) = &state.ws_tx {[m
[32m+[m[32m                let _ = tx.send(Message::Binary(chunk.into())).await;[m
[32m+[m[32m            }[m
[32m+[m[32m        }[m
[32m+[m[32m    }[m
[32m+[m[32m}[m
